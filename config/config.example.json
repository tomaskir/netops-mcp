{
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "logs/netops-mcp.log"
  },
  "security": {
    "allow_privileged_commands": false,
    "allowed_hosts": [],
    "rate_limit_requests": 100,
    "rate_limit_window": 60,
    "require_auth": false,
    "api_keys": [],
    "enable_cors": false,
    "cors_origins": []
  },
  "network": {
    "default_timeout": 30,
    "max_scan_timeout": 300,
    "allowed_ports": "1-65535"
  },
  "tool_groups": {
    "http": true,
    "connectivity": true,
    "dns": true,
    "discovery": true,
    "system_network": true,
    "monitoring": true,
    "security": true
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8815,
    "path": "/netops-mcp"
  }
}
